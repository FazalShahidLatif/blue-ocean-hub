:root {
  /* Brand Colors */
  --color-primary: #0b57d0;
  --color-primary-dark: #0842a0;
  --color-primary-light: #e8f0fe;
  --color-accent: #f59e0b;
  --color-accent-dark: #d97706;
  --color-success: #059669;
  --color-warning: #d97706;
  --color-error: #dc2626;

  /* Neutrals */
  --color-bg: #ffffff;
  --color-bg-alt: #f8fafc;
  --color-text: #111111;
  --color-text-secondary: #4b5563;
  --color-text-light: #6b7280;
  --color-border: #e5e7eb;
  --color-border-focus: #0b57d0;

  /* Typography */
  --font-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;

  /* Spacing */
  --space-xs: 0.25rem;
  --space-sm: 0.5rem;
  --space-md: 0.75rem;
  --space-lg: 1rem;
  --space-xl: 1.5rem;
  --space-2xl: 2rem;
  --space-3xl: 3rem;

  /* Radii & Shadows */
  --radius-sm: 0.25rem;
  --radius-md: 0.5rem;
  --radius-lg: 0.75rem;
  --radius-xl: 1rem;
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
  --shadow-md: 0 4px 6px rgba(0,0,0,0.1);
  --shadow-lg: 0 10px 15px rgba(0,0,0,0.1);
  --shadow-xl: 0 20px 25px rgba(0,0,0,0.15);

  /* Transitions */
  --transition-fast: 150ms ease;
  --transition-normal: 250ms ease;
  --transition-slow: 350ms ease;
}

/* Base Reset */
*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  font-family: var(--font-sans);
  font-size: 1rem;
  line-height: 1.5;
  color: var(--color-text);
  background-color: var(--color-bg);
  margin: 0;
  padding: 0;
}

a {
  color: var(--color-primary);
  text-decoration: none;
  transition: color var(--transition-fast);
}

a:hover {
  color: var(--color-primary-dark);
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-sans);
  font-weight: 700;
  line-height: 1.2;
  color: var(--color-text);
}

/* Brand Utilities */
.brand-text {
  color: var(--color-text);
}

.brand-text-secondary {
  color: var(--color-text-secondary);
}

.brand-text-light {
  color: var(--color-text-light);
}

.brand-border {
  border-color: var(--color-border);
}

.brand-bg {
  background-color: var(--color-bg);
}

.brand-bg-alt {
  background-color: var(--color-bg-alt);
}

.brand-bg-primary {
  background-color: var(--color-primary);
}

.brand-bg-primary-hover {
  background-color: var(--color-primary-dark);
}

.brand-bg-accent {
  background-color: var(--color-accent);
}

.brand-bg-accent-hover {
  background-color: var(--color-accent-dark);
}

.brand-hover-primary:hover {
  color: var(--color-primary-dark);
}

.brand-hover-primary-bg:hover {
  background-color: var(--color-primary-light);
}

.brand-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-sm) var(--space-lg);
  border-radius: var(--radius-md);
  font-weight: 600;
  transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  cursor: pointer;
  border: 2px solid transparent;
}

.brand-button-primary {
  background-color: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

.brand-button-primary:hover {
  background-color: var(--color-primary-dark);
  border-color: var(--color-primary-dark);
}

.brand-button-accent {
  background-color: var(--color-accent);
  color: #fff;
  border-color: var(--color-accent);
}

.brand-button-accent:hover {
  background-color: var(--color-accent-dark);
  border-color: var(--color-accent-dark);
}

.brand-input {
  width: 100%;
  padding: var(--space-sm) var(--space-md);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  font-family: var(--font-sans);
  font-size: 1rem;
  color: var(--color-text);
  background-color: var(--color-bg);
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.brand-input:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px var(--color-primary-light);
}

.brand-card {
  background-color: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--space-xl);
}

/* Logo Base */
.brand-logo {
  display: inline-flex;
  align-items: center;
  gap: var(--space-sm);
  font-family: var(--font-sans);
  font-weight: 800;
  font-size: 1.25rem;
  letter-spacing: 0.05em;
  color: var(--color-text);
}

.brand-logo .brand-logo-icon {
  width: 1.5rem;
  height: 1.5rem;
  background-color: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 0.75rem;
}

/* Responsive text helper */
.brand-text-sm {
  font-size: 0.875rem;
}

.brand-text-xs {
  font-size: 0.75rem;
}

.brand-uppercase {
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
