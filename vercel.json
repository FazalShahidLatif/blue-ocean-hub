{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:static",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/health.ts": {
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "redirects": [
    {
      "source": "/article/capital-gains-tax-optimization-psx-stocks",
      "destination": "/article/capital-gains-tax-psx-optimization",
      "permanent": true
    },
    {
      "source": "/article/w8bene-tax-forms-us-software-clients",
      "destination": "/article/w8bene-form-completion-guide-agencies",
      "permanent": true
    },
    {
      "source": "/article/listed-reit-commercial-yields-analysis",
      "destination": "/article/reit-commercial-rental-yield-analysis",
      "permanent": true
    },
    {
      "source": "/article/fbr-filer-vs-non-filer-tax-impacts",
      "destination": "/article/fbr-active-taxpayer-list-atl-benefits-guide",
      "permanent": true
    },
    {
      "source": "/article/voluntary-pension-schemes-vps-secp-tax-credit",
      "destination": "/article/investing-pensions-voluntary-pension-schemes",
      "permanent": true
    },
    {
      "source": "/article/stripe-atlas-firstbase-incorporation-comparison",
      "destination": "/article/stripe-atlas-vs-firstbase-delaware-inc",
      "permanent": true
    },
    {
      "source": "/article/executive-compensation-tax-shielding",
      "destination": "/article/employee-fringe-benefits-taxation-shield",
      "permanent": true
    },
    {
      "source": "/article/zero-rated-sales-tax-it-export-invoicing",
      "destination": "/article/cross-border-invoicing-vat-gst-exemptions",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/news-sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=43200, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://abscloud.org https://bauval.org https://araplhn.org https://emrldtp.cc https://ballisticcomainvitation.com https://www.topcreativeformat.com https://pl23456789.highperformanceformat.com https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https:; frame-src 'self' https://www.google.com https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
